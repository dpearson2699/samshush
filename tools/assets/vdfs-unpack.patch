-        return decompress_with(region, ctype)
-            .with_context(|| format!("hZip single-stream inflate (len={})", region.len()));
-    }
-
+    // Authenticated VDFS files store chunk hashes and a signature between
+    // the extent table and descriptor (vdfs4/inode.c init_file_decompression).
     let comp_extents_count = descr.extents_num as usize;
     let extent_struct_size = std::mem::size_of::<Vdfs4CompExtent>();
-
-    // The compressed chunks live at the front of the blob; the comp_extent
-    // table is contiguous immediately *before* the descriptor (at the tail).
-    let table_offset = descr_offset.saturating_sub(comp_extents_count * extent_struct_size);
+    let digest_size = match descr.magic[0] {
+        b'C' => 0,
+        b'I' => 16,
+        b'H' => 20,
+        b'h' => 32,
+        _ => bail!("Unknown authentication prefix"),
+    };
+    let sign_size = match descr.sign_type {
+        0 => 0,
+        1 => 128,
+        2 => 256,
+        _ => bail!("Unknown signature type"),
+    };
+    let auth_size = if digest_size == 0 { 0 } else {
+        (comp_extents_count + 1) * digest_size + sign_size
+    };
+    let table_offset = descr_offset
+        .checked_sub(auth_size + comp_extents_count * extent_struct_size)
+        .context("Extent table underflows file")?;
 
     // Decompress every chunk and concatenate. The reference tool does not
     // trust unpacked_size for sizing -- it simply writes each chunk's full
@@ -196,7 +205,8 @@ pub fn decompress_file(
             continue;
         }
         let start = comp_ext.start as usize;
-        let chunk_end = (start + chunk_len).min(data.len());
+        let chunk_end = start.checked_add(chunk_len).context("Chunk overflow")?;
+        if chunk_end > table_offset { bail!("Chunk outside data area"); }
 
         if comp_ext.flags & VDFS4_CHUNK_FLAG_UNCOMPR != 0 {
             result.extend_from_slice(&data[start..chunk_end]);
@@ -208,5 +218,8 @@ pub fn decompress_file(
         }
     }
 
+    if result.len() as u64 != descr.unpacked_size {
+        bail!("Unpacked size mismatch: got {} expected {}", result.len(), {descr.unpacked_size});
+    }
